# MOST POPULAR INTEGER

def most_popular(nums, n):
    # Find all unique numbers in the list
    unique_nums = []
    for num in nums:
        if num not in unique_nums:
            unique_nums.append(num)
            
    # Count how many times each unique number appears
    counts = []
    for num in unique_nums:
        frequency = nums.count(num)
        counts.append((frequency, num)) # Store as a pair: (how many times it appeared, the number)
        
    # Sort the pairs. 
    # Python automatically sorts by frequency first, and if frequencies match, by the number itself.
    counts.sort(reverse=True) # reverse=True puts the highest frequency first
    
    #Grab just the numbers for the top 'n' items
    x = []
    for i in range(n):
        x.append(counts[i][1]) # Get the number part of the pair
        
    # Sort the final output in non-decreasing order as requested
    x.sort()
    
    return x

