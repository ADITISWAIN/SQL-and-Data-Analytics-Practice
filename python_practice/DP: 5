# IDLE DAYS

def gpu_idle_days(days, training_sessions):
    a = days
    
    # Populate 'b' with every individual day that has a training session
    b = set()
    for start, end in training_sessions:
        for day in range(start, end + 1):
            b.add(day)
            
    # Start checking from day 1 up to 'a'
    i = 1
    idle_count = 0
    while i <= a:
        if i not in b:
            idle_count += 1
        # 3. Always increment 'i' to avoid an infinite loop
        i += 1
        
    return idle_count
