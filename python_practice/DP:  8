# VIDEO ADs INSERTION 

def can_insert_ads(feed_items, n):
    count = 0
    
    # We loop through every position including an imaginary spot (-1) at the start
    for i in range(-1, len(feed_items)):
        
        # Check if the left side is a normal post (or if we are at the very beginning)
        left_safe = (i == -1) or (feed_items[i] == 0)
        
        # Check if the right side is a normal post (or if we are at the very end)
        right_safe = (i == len(feed_items) - 1) or (feed_items[i + 1] == 0)
        
        # If both sides are safe, we found a spot to put a video ad!
        if left_safe and right_safe:
            count += 1
            # "Plant" a temporary ad here so we don't accidentally count overlapping spots next to it
            if i >= 0:
                feed_items[i] = 1
                
    # Return True if we found enough spots for all n ads
    return count >= n
